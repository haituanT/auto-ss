    {
      "id": "line-3",
      "compareSetId": "compare-1",
      "text": "Sự khác nhau là gì?",
      "role": "question",
      "pose": "question",
      "focusSide": "center",
      "highlight": "",
      "sfx": "mixkit-bubble-pop.wav",
      "start": 3.112,
