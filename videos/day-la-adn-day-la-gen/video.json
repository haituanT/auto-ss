      "poseLocked": false,
      "focusSideLocked": false,
      "dirtyVoice": false
    },
    {
      "id": "line-4",
      "compareSetId": "compare-1",
      "text": "ADN là phân tử mang thông tin di truyền của sinh vật. Nó giống như một cuốn sách hướng dẫn rất dài, chứa các thông tin giúp cơ thể hình thành, phát triển và hoạt động.",
      "role": "A",
      "pose": "point-left",
      "focusSide": "right",
      "highlight": "ADN",
      "sfx": "mixkit-hard-pop-click.wav",
      "start": 4.384,
      "duration": 7.452,
      "poseLocked": false,
      "focusSideLocked": false,
      "dirtyVoice": false
    },
    {
      "id": "line-5",
      "compareSetId": "compare-1",
      "text": "Gen là một đoạn ADN có chức năng nhất định. Nó có thể mang thông tin liên quan đến việc tạo ra một loại protein hoặc ảnh hưởng đến một đặc điểm sinh học nào đó.",
      "role": "B",
      "pose": "point-right",
      "focusSide": "left",
      "highlight": "U Ác Tính",
      "sfx": "mixkit-hard-pop-click.wav",
      "start": 11.956,
      "duration": 7.488,
      "poseLocked": false,
      "focusSideLocked": false,
      "dirtyVoice": false
    },
    {
      "id": "line-6",
      "compareSetId": "compare-2",
      "text": "Đây là hồng cầu.",
      "role": "A",
      "pose": "point-left",
      "focusSide": "right",
      "highlight": "hồng cầu",
      "sfx": "mixkit-hard-pop-click.wav",
      "start": 19.564,
      "duration": 1.656,
      "poseLocked": false,
      "focusSideLocked": false,
      "dirtyVoice": false
    },
    {
      "id": "line-7",
      "compareSetId": "compare-2",
      "text": "Đây là bạch cầu.",
      "role": "B",
      "pose": "point-right",
      "focusSide": "left",
      "highlight": "bạch cầu",
      "sfx": "mixkit-hard-pop-click.wav",
      "start": 21.34,
      "duration": 1.512,
      "poseLocked": false,
      "focusSideLocked": false,
      "dirtyVoice": false
    },
    {
      "id": "line-8",
      "compareSetId": "compare-2",
      "text": "Sự khác nhau là gì?",
      "role": "question",
      "pose": "question",
      "focusSide": "center",
      "highlight": "",
      "sfx": "mixkit-bubble-pop.wav",
      "start": 22.972,
      "duration": 1.044,
      "poseLocked": false,
      "focusSideLocked": false,
      "dirtyVoice": false
    },
    {
      "id": "line-9",
      "compareSetId": "compare-2",
      "text": "Hồng cầu là tế bào máu có nhiệm vụ chính là vận chuyển oxy. Nhờ hồng cầu, oxy từ phổi được đưa đi khắp cơ thể để não, tim, cơ bắp và các cơ quan khác hoạt động. Có màu đỏ vì chứa huyết sắc tố, nên máu của chúng ta nhìn có màu đỏ.",
      "role": "A",
      "pose": "point-left",
      "focusSide": "right",
      "highlight": "hồng cầu",
      "sfx": "mixkit-hard-pop-click.wav",
      "start": 24.136,
      "duration": 12.852,
      "poseLocked": false,
      "focusSideLocked": false,
      "dirtyVoice": false
    },
    {
      "id": "line-10",
      "compareSetId": "compare-2",
      "text": "Bạch cầu thì khác nó liên quan đến hệ miễn dịch. Nó giống như đội bảo vệ của cơ thể, giúp chống lại vi khuẩn, virus, ký sinh trùng hoặc những yếu tố lạ xâm nhập.",
      "role": "B",
      "pose": "point-right",
      "focusSide": "left",
      "highlight": "bạch cầu",
      "sfx": "mixkit-hard-pop-click.wav",
      "start": 37.108,
      "duration": 8.136,
      "poseLocked": false,
      "focusSideLocked": false,
      "dirtyVoice": false
    }
