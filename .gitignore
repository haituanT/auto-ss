# Dependencies
node_modules/

# Local FFmpeg binaries are provisioned for this workspace but exceed normal Git hosting limits.
tools/ffmpeg/bin/

# Environment files — one shared .env at repo root (AIMAX credentials); no leading
# slash, so this also catches an accidental .env dropped inside videos/<name>/
.env
.env.local
.env.*.local

# Editor caches — matched at any depth since these patterns have no leading slash
.thumbnails/
.waveform-cache/

# Render outputs and snapshots — regenerated by the renderer, not committed
renders/
snapshots/

# Remotion render scratch space. Jobs are recreated before each render.
public/remotion/jobs/

# Studio build output and local temporary work files.
studio/frontend/dist/
docs/previews/
tmp/
temp/
*.zip
videos/*/jobs/
videos/*/renders/
videos/*/snapshots/

# Only this one demo video is meant to be pushed to this repo; every other
# videos/<name>/ directory (new topics, experiments, etc.) stays local-only.
videos/*
!videos/day-la-adn-day-la-gen/
!videos/day-la-adn-day-la-gen/**
# Generated folders stay local even inside the shared demo project.
videos/day-la-adn-day-la-gen/.thumbnails/
videos/day-la-adn-day-la-gen/.waveform-cache/
videos/day-la-adn-day-la-gen/jobs/
videos/day-la-adn-day-la-gen/renders/
videos/day-la-adn-day-la-gen/snapshots/

# User-uploaded local assets; not part of the shared source repository.
shared-assets/.uploads/

# Large source character videos are local-only. The small processed versions
# below shared-assets/characters/default/processed/ are enough for the app.
shared-assets/characters/default/*.mp4
shared-assets/characters/default/*.mov
shared-assets/characters/default/originals/

# Codex machine-local settings are not committed.
.codex/settings.local.json

# Editor
.vscode/

# OS specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.lnk

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log
