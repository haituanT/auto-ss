AIMAX_API_KEY=
AIMAX_BASE_URL=https://aimaxstudio.com
AIMAX_TTS_PROVIDER=minimax
AIMAX_TTS_MODEL=speech-2.8-hd
AIMAX_TTS_SPEED=1.1

# Voice clone AIMAX. If blank, the script selects the first voice returned by AIMAX.
AIMAX_VOICE_ID=

# One AIMAX job receives newline-separated video.json lines and returns segment audio.
AIMAX_TTS_MAX_LINES=200
AIMAX_TTS_POLL_INTERVAL_MS=2000

# Optional override when ffprobe is not in tools/ffmpeg/bin.
# FFPROBE_PATH=C:\path\to\ffprobe.exe

# 0 = confirm content and render choices; 1 = run the creation workflow automatically.
AUTO_CREATE_VIDEO=0
CHANNEL=Cuong IT

# Studio runs on loopback by default. Set both values only when exposing it
# beyond the local machine.
STUDIO_HOST=127.0.0.1
STUDIO_PORT=3101
STUDIO_AUTH_TOKEN=
VITE_STUDIO_AUTH_TOKEN=

# Keep AI CLI permission bypasses disabled when the installed CLI supports its
# normal approval/sandbox flow.
AUTO_COMPARE_AI_CLI_ALLOW_DANGEROUS_PERMISSIONS=0
